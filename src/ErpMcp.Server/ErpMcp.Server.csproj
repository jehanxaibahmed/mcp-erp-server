<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>erp-mcp</AssemblyName>
    <RootNamespace>ErpMcp.Server</RootNamespace>
    <UserSecretsId>erp-mcp-server</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- ASP.NET Core is only used by the optional HTTP transport (`erp-mcp http`). -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="ModelContextProtocol" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ErpMcp.Application\ErpMcp.Application.csproj" />
    <ProjectReference Include="..\ErpMcp.Infrastructure\ErpMcp.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ErpMcp.UnitTests" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
